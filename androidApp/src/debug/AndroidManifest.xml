<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true">
        <!--
          机の上で走行を模擬するための口。Debug ビルドにしか入らない。
          DUMP は adb shell が持ち、通常のアプリへは付与されない。現在地の差し替えを adb からだけに限る。
        -->
        <receiver android:name="com.theacar.android.debug.DemoDriveReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.theacar.debug.DRIVE" />
            </intent-filter>
        </receiver>
        <!-- ドライブシミュレータ（simulator/）で走った位置を現在地として受け取る。DRIVE と同じく adb からだけ -->
        <receiver android:name="com.theacar.android.debug.SimulatorLinkReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.theacar.debug.SIMULATOR" />
            </intent-filter>
        </receiver>
        <!-- アプリが落ちて開き直されたとき、前のシミュレータへつなぎ直す。外からは呼べない -->
        <provider android:name="com.theacar.android.debug.SimulatorLinkStarter"
            android:authorities="${applicationId}.simulator-link" android:exported="false" />
    </application>
</manifest>
