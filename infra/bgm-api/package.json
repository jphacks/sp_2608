{
  "name": "bgm-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest run && vitest run --config vitest.node.config.mts",
    "cf-typegen": "wrangler types",
    "simulate": "tsx scripts/simulate.ts",
    "catalog": "tsx scripts/catalog.ts",
    "test:workers": "vitest",
    "test:node": "vitest run --config vitest.node.config.mts",
    "build:node": "esbuild src/node.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/node.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "^4.13.13"
  }
}
